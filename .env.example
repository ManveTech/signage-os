# Server Configuration
NODE_ENV=production
PORT=5000

# CORS Configuration (comma-separated list of allowed origins)
# In production, list your frontend domains. Example: https://app.yourcompany.com,https://cms.yourcompany.com
# Leave empty in development to allow all origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# JWT Secret (MUST be changed in production - use a strong random string)
JWT_SECRET=your_very_strong_random_secret_here_change_me

# PocketBase Configuration (REQUIRED in production)
POCKETBASE_URL=https://your-pocketbase-instance.com
PB_ADMIN_EMAIL=admin@yourcompany.com
PB_ADMIN_PASSWORD=your_secure_password_here

# SMTP Configuration (Required for email notifications)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER_EMAIL=noreply@yourcompany.com
SMTP_SENDER_NAME=SignageOS

# Razorpay Payment Gateway (Required for license billing)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Separate secret from the one above — configured in Razorpay Dashboard >
# Settings > Webhooks. Required for /payments/webhook to accept anything;
# without it the endpoint refuses all requests rather than trusting an
# unverifiable payment event.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 / AWS S3 Storage (Optional - for external media storage).
# This is also how media/thumbnails get CDN-backed delivery: R2's own public
# URL and any custom domain you attach to the bucket are both served through
# Cloudflare's edge network automatically. When S3_ENABLED=false, media falls
# back to being stored in PocketBase directly with no CDN in front of it.
S3_ENABLED=false
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET=your_secret_key
# Set this if you've attached a custom public domain to the R2 bucket in the
# Cloudflare dashboard. If left empty, falls back to R2's own endpoint URL.
R2_PUBLIC_URL=

# Redis Configuration (Optional, but required for rate limiting to work
# across restarts, Socket.IO horizontal scaling, and video-conference state
# to survive more than one server instance). The code reads REDIS_URL as a
# single connection string, not separate host/port/password fields.
REDIS_URL=redis://localhost:6379

# Frontend Configuration (for vite build)
VITE_POCKETBASE_URL=https://your-pocketbase-instance.com
VITE_NODE_SERVER_URL=https://your-api-server.com
